var quantidade = 0
para var i = 1; i <=10; i = i + 1 {
var numero = inteiro(leia("Digite um numero inteiro (ou -1 para sair):"))
se (numero == -1
) { 
sustar
}
soma = soma + numero
quantidade = quantidade + 1
}
se (quantidade > 0) {
var media = soma / quantidade
escreva (" Quantidade de valores lidos: " + texto(quantidade))
escreva ("Media dos valores: " + texto(media))
}
senao { 
